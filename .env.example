# Copy to .env and change defaults before any real patient data is stored.

POSTGRES_USER=lab
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=diagnostic_lab

SECRET_KEY=replace-with-a-long-random-string
COOKIE_SECURE=false
# Set COOKIE_SECURE=true when serving over HTTPS

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

CLINIC_NAME=Open Diagnostic Lab
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_FOOTER=This report is computer generated. Confidential patient information.

WEB_PORT=8080
